# =============================================================================
# Aqar Exit - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# Application Mode: 'demo' | 'development' | 'production'
# - demo: Uses in-memory fictional data, no external services required
# - development: Connects to Supabase dev project (requires keys below)
# - production: Connects to Supabase production project (requires keys below)
# Default: demo
APP_MODE=demo

# Supabase Configuration (required for development and production modes)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - never expose to browser)
# Only needed for admin operations in API routes
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
